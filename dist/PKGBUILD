# Maintainer: ${MAINTAINER_NAME} <${MAINTAINER_EMAIL}>
pkgname=unfk-bin
pkgver=${VERSION}
pkgrel=1
pkgdesc='A fast, modern CLI tool for scanning and repairing file formatting issues'
arch=('x86_64' 'aarch64')
url='https://github.com/keathmilligan/unfk'
license=('MIT')
provides=('unfk')
conflicts=('unfk')

source_x86_64=("https://github.com/keathmilligan/unfk/releases/download/v${pkgver}/unfk-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/keathmilligan/unfk/releases/download/v${pkgver}/unfk-${pkgver}-aarch64-unknown-linux-gnu.tar.gz")

sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "unfk" "${pkgdir}/usr/bin/unfk"
}
