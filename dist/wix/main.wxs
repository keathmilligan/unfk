<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX3 installer source for unfk.
  Requires: cargo-wix, WiX Toolset v3
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='unfk'
    UpgradeCode='B3F2A1D4-7C8E-4F9B-A2D5-6E3C8B1F4A7D'
    Manufacturer='Keath Milligan'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package Id='*'
      Keywords='Installer'
      Description='A fast, modern CLI tool for scanning and repairing file formatting issues'
      Manufacturer='Keath Milligan'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      SummaryCodepage='1252'/>

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

    <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
    <Property Id='DiskPrompt' Value='unfk Installation'/>

    <!-- ═══════════════════════════════════════════════════════════════
         Directory structure
    ════════════════════════════════════════════════════════════════ -->
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONROOTDIRECTORY' Name='unfk'/>
      </Directory>
    </Directory>

    <!-- ═══════════════════════════════════════════════════════════════
         Components
    ════════════════════════════════════════════════════════════════ -->
    <DirectoryRef Id='APPLICATIONROOTDIRECTORY'>
      <Component Id='binary0' Guid='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'>
        <File
          Id='exe0'
          Name='unfk.exe'
          DiskId='1'
          Source='$(var.CargoTargetBinDir)\unfk.exe'
          KeyPath='yes'/>
      </Component>

      <!-- Add install directory to system PATH -->
      <Component Id='PathComponent' Guid='F9E8D7C6-B5A4-3210-FEDC-BA9876543210'>
        <Environment
          Id='PATH'
          Name='PATH'
          Value='[APPLICATIONROOTDIRECTORY]'
          Permanent='no'
          Part='last'
          Action='set'
          System='yes'/>
        <RegistryValue
          Root='HKCU'
          Key='Software\unfk'
          Name='installed'
          Type='integer'
          Value='1'
          KeyPath='yes'/>
      </Component>
    </DirectoryRef>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature
    ════════════════════════════════════════════════════════════════ -->
    <Feature
      Id='MainProgram'
      Title='unfk'
      Description='Installs unfk CLI.'
      Display='expand'
      Level='1'
      ConfigurableDirectory='APPLICATIONROOTDIRECTORY'>
      <ComponentRef Id='binary0'/>
      <ComponentRef Id='PathComponent'/>
    </Feature>

    <!-- ═══════════════════════════════════════════════════════════════
         UI
    ════════════════════════════════════════════════════════════════ -->
    <UIRef Id='WixUI_FeatureTree'/>
    <UIRef Id='WixUI_ErrorProgressText'/>
    <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

    <!-- ═══════════════════════════════════════════════════════════════
         Add/Remove Programs metadata
    ════════════════════════════════════════════════════════════════ -->
    <Property Id='ARPHELPLINK' Value='https://github.com/keathmilligan/unfk'/>
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/keathmilligan/unfk'/>
    <Property Id='ARPURLUPDATEINFO' Value='https://github.com/keathmilligan/unfk/releases'/>
    <Property Id='ARPNOREPAIR' Value='1' Secure='yes'/>

  </Product>
</Wix>
