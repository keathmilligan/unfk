<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX configuration for unfk MSI installer.
  Used by cargo-wix during the release pipeline.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="unfk"
    UpgradeCode="B1E5C4A2-3D7F-4E8B-9A6C-2F1D0E3B5A8C"
    Manufacturer="Keath Milligan"
    Language="1033"
    Codepage="1252"
    Version="!(bind.FileVersion.unfkExe)">

    <Package
      Id="*"
      Keywords="Installer"
      Description="unfk - File formatting scanner and repair tool"
      Manufacturer="Keath Milligan"
      InstallerVersion="450"
      Languages="1033"
      Compressed="yes"
      InstallScope="perMachine"
      SummaryCodepage="1252" />

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="unfk Installation" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder" Name="PFiles">
        <Directory Id="APPLICATIONFOLDER" Name="unfk">
          <Component Id="unfkBinary" Guid="*" Win64="yes">
            <File
              Id="unfkExe"
              Name="unfk.exe"
              DiskId="1"
              Source="target\release\unfk.exe"
              KeyPath="yes" />

            <Environment
              Id="PATH"
              Name="PATH"
              Value="[APPLICATIONFOLDER]"
              Permanent="no"
              Part="last"
              Action="set"
              System="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature
      Id="Binaries"
      Title="Application"
      Description="Installs the unfk binary."
      Level="1"
      ConfigurableDirectory="APPLICATIONFOLDER"
      AllowAdvertise="no"
      Display="expand"
      Absent="disallow">
      <ComponentRef Id="unfkBinary" />
    </Feature>

    <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize" />

    <Icon Id="ProductICO" SourceFile="wix\unfk.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductICO" />
    <Property Id="ARPHELPLINK" Value="https://github.com/keathmilligan/unfk" />

    <UI>
      <UIRef Id="WixUI_FeatureTree" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="wix\License.rtf" />
  </Product>
</Wix>
